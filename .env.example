# Agants — example config  (copy to .env and fill in your values)

# ── Brain assignments ──────────────────────────────────────────────────────────
# Each colony is independently "bot", "llm", or "mcp"
RED_BRAIN_TYPE=bot
BLUE_BRAIN_TYPE=bot

# For LLM colonies — any OpenAI-compatible endpoint
RED_API_KEY=
RED_BASE_URL=https://api.openai.com/v1
RED_MODEL=gpt-4o

BLUE_API_KEY=
BLUE_BASE_URL=https://api.openai.com/v1
BLUE_MODEL=gpt-4o

# ── Game settings ──────────────────────────────────────────────────────────────
TPS=1                # ticks per second (1–60)
LLM_INTERVAL=15      # ticks between LLM strategy calls
LOG_MAX_MB=50        # max total size of logs/ before oldest run_*.log is rotated out

# ── Auth layer (optional — leave blank to run open-access) ─────────────────────
AGANTS_AUTH_URL=     # https://agants-auth.workers.dev  (your CF Worker URL)
AGANTS_AUTH_SECRET=  # shared secret — set this AND `wrangler secret put INTERNAL_SECRET`
