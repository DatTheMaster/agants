# Agants — example config  (copy to .env and fill in your values)

# ── Brain assignments ──────────────────────────────────────────────────────────
# Each colony is independently "bot", "llm", or "mcp"
RED_BRAIN_TYPE=bot
BLUE_BRAIN_TYPE=bot

# For LLM colonies — any OpenAI-compatible endpoint
RED_API_KEY=
RED_BASE_URL=https://api.openai.com/v1
RED_MODEL=gpt-4o

BLUE_API_KEY=
BLUE_BASE_URL=https://api.openai.com/v1
BLUE_MODEL=gpt-4o

# ── Game settings ──────────────────────────────────────────────────────────────
TPS=10               # ticks per second (1–60)
LLM_INTERVAL=100     # ticks between LLM strategy calls
