# Agants Controller — drop a copy of this as .env next to controller.py

# ── LLM provider (required) ───────────────────────────────────────────────────
LLM_API_KEY=sk-...                         # your LLM provider key
LLM_BASE_URL=https://api.openai.com/v1    # any OpenAI-compatible endpoint
LLM_MODEL=gpt-4o                          # model name

# ── Game server ────────────────────────────────────────────────────────────────
AGANTS_GAME_URL=https://api.datthemaster.com/agants   # leave as-is for the live server

# ── Agants account (optional — tracks win/loss history) ───────────────────────
AGANTS_API_KEY=                           # from agants.datthemaster.com/register.html
